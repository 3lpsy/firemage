# Copy to .env and set your Cargo sparse registry index URL.
# Keep the sparse+ prefix and trailing slash.
FIREMAGE_DEPENDENCY_INDEX=sparse+https://deps.example.com/crates/index/

# Fedora base, or its equivalent path through your container registry mirror.
FIREMAGE_TOOLCHAIN_BASE_IMAGE=docker.io/library/fedora:44

# Optional overrides. Docker is preferred when both engines are installed.
# CONTAINER_ENGINE=podman
# FIREMAGE_TOOLCHAIN_IMAGE=registry.example.com/firemage-toolchain:latest
# FIREMAGE_TOOLCHAIN_SOURCE=registry
# FIREMAGE_TOOLCHAIN_CACHE=registry.example.com/firemage-buildcache/toolchain
# FIREMAGE_DEPENDENCIES_IMAGE=firemage-dependencies
# FIREMAGE_CONTAINER_USER=1000:1000
# FIREMAGE_DOCKER_NETWORK=host

# Optional local ci-setup values. flanforge.yml pins these directly.
# FIREMAGE_FIRECRACKER_URL=https://github.com/firecracker-microvm/firecracker/releases/download/v1.16.1/firecracker-v1.16.1-x86_64.tgz
# FIREMAGE_FIRECRACKER_SHA256=382a02a869e4d6d5cb14c40577f9545e8458021ea8b0b2d3fc10ec14d9c242e6

# Forgejo helpers use this remote and the token stored by fj, unless overridden.
# FIREMAGE_FJ_REMOTE=internal
# FORGEJO_HOST=git.example.com
# FORGEJO_REPO_PATH=owner/firemage
# FORGEJO_TOKEN=<token>

# Canonical browser origin; set this when nginx terminates HTTPS.
# FIREMAGE_PUBLIC_URL=https://firemage.example.com
# FIREMAGE_OIDC_ISSUER=https://identity.example.com/realms/operations
# FIREMAGE_OIDC_CLIENT_ID=firemage
# FIREMAGE_OIDC_CLIENT_SECRET=<client-secret>
# FIREMAGE_OIDC_CA_CERT=/etc/firemage/identity-ca.pem

# Optional local UI override; release binaries embed the built UI.
# FIREMAGE_WEBUI_DIR=dist/webui

# Optional server upstream proxy; value is TOML, credentials reference named secrets.
# FIREMAGE_EGRESS_UPSTREAM='url = "socks5://proxy.example.com:1080"'
